# ---------------------------------------------------------------------------
# Lumen — plantilla de variables de entorno
#
# Copia este archivo a .env y pide los valores reales por el chat privado del
# equipo. .env esta en .gitignore: NUNCA lo commitees.
#
#   Windows:  Copy-Item .env.example .env
#   Mac/Linux: cp .env.example .env
# ---------------------------------------------------------------------------


# --- Croma (fuente unica de datos) -----------------------------------------
# API HTTP POST https://api.croma.run/co/.../v1. Ver HERRAMIENTAS.md y
# api/lumen/croma/client.py. El MCP de Cursor no lo usa el backend.
CROMA_API_KEY=


# --- IA (Cursor SDK) --------------------------------------------------------
# Presupuesto duro: US$50. Dueno: Freddy (B2). Revisar consumo a las 20:00 y 23:00.
CURSOR_API_KEY=
# Modelo por defecto para narracion y resolucion de entidades (rapido y barato).
LUMEN_MODELO_RAPIDO=composer-2.5
# Modelo fuerte, solo para el lector de justificaciones. Confirmar con
# Cursor.models.list() antes de fijarlo: no hardcodear a ciegas.
LUMEN_MODELO_FUERTE=
# Directorio de trabajo del agente. NUNCA la raiz del repo: un agente suelto
# sobre el repo lee archivos que nadie pidio y quema presupuesto.
LUMEN_SCRATCH_DIR=./scratch


# --- Supabase (base de datos y cache) --------------------------------------
# Un solo proyecto cloud compartido. Dueno unico de migraciones: Cristian (B3).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cadena de conexion directa, solo para la CLI de migraciones.
SUPABASE_DB_URL=


# --- Twilio (WhatsApp, sandbox) --------------------------------------------
# Sin resolver todavia. Es el hard-cut #3: si no sale, el video muestra la
# alerta dentro de la plataforma. No se mockea un WhatsApp falso.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Telefono que recibe la alerta en el video. En el sandbox tiene que haberse
# unido antes mandando "join <codigo>" al numero de Twilio.
TWILIO_WHATSAPP_TO_DEMO=


# --- Aplicacion -------------------------------------------------------------
LUMEN_ENV=local
LUMEN_LOG_LEVEL=info

# Origenes permitidos por CORS, separados por coma. Andrew define su stack y su
# puerto: cuando lo sepa, se agrega aqui y en las variables de Render.
# El comodin "*" solo vale en local.
LUMEN_CORS_ORIGINS=*

# Respaldo de grabacion (§5.3). En true, la API responde desde el dump JSON
# versionado en vez de tocar Supabase o Croma. Existe para que un corte de red
# a las 07:00 no cueste el hackathon. NO es la arquitectura.
LUMEN_USAR_DUMP_LOCAL=false
LUMEN_DUMP_PATH=./fixtures/casos_demo.json
