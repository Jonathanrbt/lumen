# URL base de la API. Sin esto la app corre entera contra fixtures/.
# Local:   http://127.0.0.1:8000
# Render:  https://lumen-api-cwt3.onrender.com   <-- la viva, /health en 200
#
# Vite congela esta variable EN EL BUILD, no en tiempo de ejecucion: si se
# cambia hay que volver a construir y a desplegar, no basta con tocarla en el
# panel de Cloudflare.
#
# CORS ya no bloquea nada: LUMEN_CORS_ORIGINS esta en "*" en Render (seguro
# porque la API monta CORS con allow_credentials=False). El dominio del
# frontend si hace falta para LUMEN_FRONTEND_URL, que es el enlace que viaja
# dentro del mensaje de WhatsApp.
VITE_API_URL=https://lumen-api-cwt3.onrender.com
